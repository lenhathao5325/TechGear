@model TechGearMVC.Models.ProductVM

<div class="card">
  <div class="card-body">
    <h3 class="card-title">Thêm sản phẩm</h3>
    <form asp-action="Create" method="post" class="needs-validation" novalidate>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Tên sản phẩm</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-tag"></i></span>
            <input asp-for="Name" class="form-control" required />
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label">Giá</label>
          <div class="input-group">
            <span class="input-group-text">₫</span>
            <input asp-for="Price" class="form-control" type="number" step="0.01" required />
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label">Category</label>
          <select asp-for="CategoryId" class="form-select">
            <option value="">-- Chọn --</option>
            @foreach(var c in Model.Categories)
            {
              <option value="@c.Id">@c.Name</option>
            }
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Brand</label>
          <select asp-for="BrandId" class="form-select">
            <option value="">-- Chọn --</option>
            @foreach(var b in Model.Brands)
            {
              <option value="@b.Id">@b.Name</option>
            }
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">Mô tả</label>
          <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
      </div>
      <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-save me-2"></i>Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
      </div>
    </form>
  </div>
</div> 