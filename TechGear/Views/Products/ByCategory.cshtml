@model IEnumerable<TechGear.Models.Product>

@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Danh sách sản phẩm";
    var brands = ViewBag.Brands as IEnumerable<TechGear.Models.Brand> ?? new List<TechGear.Models.Brand>();
    int categoryId = ViewBag.CategoryId;
    int? selectedBrand = ViewBag.SelectedBrand as int?;
}

<div class="container my-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="text-decoration-none text-muted">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active fw-bold">
                @ViewBag.CategoryName
            </li>
        </ol>
    </nav>

    <div class="row">

        <!-- FILTER SIDEBAR -->
        <aside class="col-lg-3 mb-4">
            <div class="filter-sidebar sticky-top" style="top:90px">

                <div class="filter-header d-flex justify-content-between">
                    <strong><i class="fa fa-filter me-2"></i>BỘ LỌC</strong>

                    <a asp-action="ByCategory"
                       asp-route-id="@categoryId"
                       class="small text-decoration-none">
                        Xóa tất cả
                    </a>
                </div>

                <!-- BRAND FILTER -->
                <div class="filter-group mt-3">
                    <div class="filter-title"
                         data-bs-toggle="collapse"
                         data-bs-target="#collapseBrand">
                        Thương hiệu <i class="fa fa-chevron-down small"></i>
                    </div>

                    <div class="collapse show" id="collapseBrand">
                        <div class="d-flex flex-column gap-2 mt-2">

                            @foreach (var brand in brands)
                            {
                                bool isChecked = selectedBrand == brand.BrandId;

                                <a asp-action="ByCategory"
                                   asp-route-id="@categoryId"
                                   asp-route-brandId="@brand.BrandId"
                                   class="form-check text-decoration-none text-dark">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="brand"
                                           checked="@isChecked"
                                           onclick="this.parentElement.click()" />

                                    <label class="form-check-label ms-1">
                                        @brand.BrandName
                                    </label>
                                </a>
                            }

                        </div>
                    </div>
                </div>

            </div>
        </aside>

        <!-- PRODUCT LIST -->
        <section class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h5 fw-bold mb-0">@ViewBag.CategoryName</h1>
                    <small class="text-muted">
                        Tìm thấy <strong>@Model.Count()</strong> sản phẩm
                    </small>
                </div>

                <select class="form-select form-select-sm w-auto">
                    <option>Mới nhất</option>
                    <option>Giá thấp → cao</option>
                    <option>Giá cao → thấp</option>
                </select>
            </div>

            @if (Model.Any())
            {
                <div class="row row-cols-2 row-cols-md-3 g-3">

                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">

                                <a asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@item.ImageUrl"
                                         class="card-img-top p-3"
                                         alt="@item.Name">
                                </a>

                                <div class="card-body d-flex flex-column">
                                    <small class="text-muted text-uppercase">
                                        @item.Brand?.BrandName
                                    </small>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="fw-bold text-dark text-decoration-none">
                                        @item.Name
                                    </a>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-box-open fa-3x mb-3"></i>
                    <h5>Không có sản phẩm</h5>
                </div>
            }

        </section>
    </div>
</div>
