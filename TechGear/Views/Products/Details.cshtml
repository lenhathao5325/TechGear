@model TechGear.Models.Product

@{
    ViewData["Title"] = Model.Name;
    // Gi? l?p giá g?c cao hon 10% d? t?o hi?u ?ng gi?m giá
    // var originalPrice = Model.Price * 1.1;
}

<div class="container my-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang ch?</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">

        <div class="col-lg-5">
            <div class="product-gallery sticky-top" style="top: 100px; z-index: 1;">
                <div class="main-img-wrap bg-white shadow-sm mb-3">
                    <img src="@Model.ImageUrl" class="img-fluid d-block mx-auto" alt="@Model.Name" style="max-height: 400px;" />
                </div>

                <div class="thumb-list d-flex gap-2 justify-content-center">
                    <img src="@Model.ImageUrl" class="active" alt="View 1" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 2" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 3" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 4" />
                </div>
            </div>
        </div>

        <div class="col-lg-7">

            <h1 class="fw-bold fs-3 mb-2">@Model.Name</h1>
            <div class="d-flex align-items-center gap-3 mb-3 text-small">
                <div class="text-warning">
                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                </div>
                <span class="text-muted border-start ps-3">Mã SP: <strong>TG-@Model.Id</strong></span>
                <span class="text-muted border-start ps-3">Thuong hi?u: <a href="#" class="text-orange text-decoration-none">@Model.BrandName</a></span>
            </div>

            @* <div class="bg-light p-3 rounded mb-4 d-flex align-items-center gap-3">
                <h2 class="fw-bold text-danger mb-0">@Model.Price.ToString("N0")?</h2>
                <span class="text-decoration-line-through text-muted fs-5">@originalPrice.ToString("N0")?</span>
                <span class="badge bg-danger rounded-pill">-10%</span>
            </div> *@

            <div class="mb-4">
                <p class="mb-2 fw-bold"><i class="fa fa-cogs me-2"></i>Thông s? tóm t?t:</p>
                <ul class="row row-cols-2 list-unstyled small text-muted g-2">
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Chính hãng 100%</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> B?o hành 12 tháng</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Full VAT</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> H? tr? tr? góp 0%</li>
                </ul>
            </div>

            <div class="policy-box mb-4">
                <h6 class="fw-bold text-orange mb-3"><i class="fa fa-gift me-2"></i>UU ÐÃI Ð?C QUY?N</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>T?ng Balo Gaming cao c?p tr? giá 500k</span>
                    </div>
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>Gi?m thêm <strong>200k</strong> khi mua kèm màn hình</span>
                    </div>
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>H? tr? cài d?t ph?n m?m tr?n d?i</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mb-4">
                @{
                    var isLoggedIn = Context.Session.GetString("JWToken") != null;
                    var userRole = Context.Session.GetString("UserRole");
                    var isUser = userRole == "User" || string.IsNullOrEmpty(userRole);
                }
                
                @if (isLoggedIn && isUser)
                {
                    <div class="flex-grow-1">
                        <form asp-controller="Order" asp-action="Checkout" method="get" class="d-inline w-100">
                            <button type="submit" class="btn btn-danger w-100 py-3 text-uppercase fw-bold">
                                <span class="fs-5 d-block">Mua ngay</span>
                                <span class="small fw-normal">Giao hàng tận nơi hoặc nhận tại cửa hàng</span>
                            </button>
                        </form>
                    </div>
                    <div>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productVariantId" value="@(Model.Variants?.FirstOrDefault()?.Id ?? 0)" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-outline-warning py-3 px-4 d-flex flex-column align-items-center h-100 justify-content-center">
                                <i class="fa fa-cart-plus fs-4"></i>
                                <span class="small fw-bold mt-1">Thêm giỏ</span>
                            </button>
                        </form>
                    </div>
                }
                else if (!isLoggedIn)
                {
                    <div class="flex-grow-1">
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-danger w-100 py-3 text-uppercase fw-bold text-decoration-none">
                            <span class="fs-5 d-block">Đăng nhập để mua hàng</span>
                            <span class="small fw-normal">Vui lòng đăng nhập để tiếp tục</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex-grow-1">
                        <div class="alert alert-info mb-0">
                            <i class="fa fa-info-circle me-2"></i>
                            Bạn cần đăng nhập với tài khoản User để mua hàng.
                        </div>
                    </div>
                }
            </div>

            <div class="border rounded p-3 bg-white shadow-sm">
                <div class="row text-center row-cols-3 small">
                    <div class="col">
                        <i class="fa fa-shield-alt text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">B?o hành uy tín</div>
                    </div>
                    <div class="col border-start border-end">
                        <i class="fa fa-sync text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">Ð?i tr? 15 ngày</div>
                    </div>
                    <div class="col">
                        <i class="fa fa-truck text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">Free Shipping</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="bg-white p-4 rounded shadow-sm">

                <ul class="nav nav-tabs mb-4" id="productTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fs-5" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button">Mô t? s?n ph?m</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fs-5" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button">Thông s? k? thu?t</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fs-5" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button">Ðánh giá (0)</button>
                    </li>
                </ul>

                <div class="tab-content" id="productTabContent">

                    <div class="tab-pane fade show active" id="desc">
                        <div class="content-body text-secondary" style="line-height: 1.8;">
                            <h5 class="fw-bold text-dark mb-3">Ðánh giá chi ti?t @Model.Name</h5>
                            <p>@Model.Description</p>
                            <p>S?n ph?m <strong>@Model.Name</strong> mang d?n hi?u nang vu?t tr?i v?i thi?t k? hi?n d?i...</p>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="specs">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <h5 class="fw-bold mb-3">C?u hình chi ti?t</h5>
                                <table class="table table-striped table-hover tech-specs-table border">
                                    <tbody>
                                        <tr>
                                            <th>Thuong hi?u</th>
                                            <td>@Model.BrandName</td>
                                        </tr>
                                        <tr>
                                            <th>Tên s?n ph?m</th>
                                            <td>@Model.Name</td>
                                        </tr>
                                        <tr>
                                            <th>B?o hành</th>
                                            <td>12 Tháng</td>
                                        </tr>
                                        <tr>
                                            <th>Màu s?c</th>
                                            <td>Ðen / Xám</td>
                                        </tr>
                                        <tr>
                                            <th>Ch?t li?u</th>
                                            <td>Nhôm nguyên kh?i</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>



                    
                    @* <div class="tab-pane fade" id="review">
                        <div class="text-center py-5">
                            <i class="fa fa-comment-dots fa-3x text-muted mb-3 opacity-25"></i>
                            <p class="text-muted">Chua có dánh giá nào cho s?n ph?m này.</p>
                            <button class="btn btn-orange">Vi?t dánh giá ngay</button>
                        </div>
                    </div> *@

                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h4 class="fw-bold mb-4">S?n ph?m liên quan</h4>
    </div>

</div>
