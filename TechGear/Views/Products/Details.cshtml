@model TechGear.Models.Product

@{
    ViewData["Title"] = Model.Name;
    // Giả lập giá gốc cao hơn 10% để tạo hiệu ứng giảm giá
    // var originalPrice = Model.Price * 1.1;
}

<div class="container my-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">@Model.Category?.CategoryName</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">

        <div class="col-lg-5">
            <div class="product-gallery sticky-top" style="top: 100px; z-index: 1;">
                <div class="main-img-wrap bg-white shadow-sm mb-3">
                    <img src="@Model.ImageUrl" class="img-fluid d-block mx-auto" alt="@Model.Name" style="max-height: 400px;" />
                </div>

                <div class="thumb-list d-flex gap-2 justify-content-center">
                    <img src="@Model.ImageUrl" class="active" alt="View 1" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 2" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 3" />
                    <img src="@Model.ImageUrl" class="opacity-50" alt="View 4" />
                </div>
            </div>
        </div>

        <div class="col-lg-7">

            <h1 class="fw-bold fs-3 mb-2">@Model.Name</h1>
            <div class="d-flex align-items-center gap-3 mb-3 text-small">
                <div class="text-warning">
                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                </div>
                <span class="text-muted border-start ps-3">Mã SP: <strong>TG-@Model.Id</strong></span>
                <span class="text-muted border-start ps-3">Thương hiệu: <a href="#" class="text-orange text-decoration-none">@Model.Brand?.BrandName</a></span>
            </div>

            @* <div class="bg-light p-3 rounded mb-4 d-flex align-items-center gap-3">
                <h2 class="fw-bold text-danger mb-0">@Model.Price.ToString("N0")₫</h2>
                <span class="text-decoration-line-through text-muted fs-5">@originalPrice.ToString("N0")₫</span>
                <span class="badge bg-danger rounded-pill">-10%</span>
            </div> *@

            <div class="mb-4">
                <p class="mb-2 fw-bold"><i class="fa fa-cogs me-2"></i>Thông số tóm tắt:</p>
                <ul class="row row-cols-2 list-unstyled small text-muted g-2">
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Chính hãng 100%</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Bảo hành 12 tháng</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Full VAT</li>
                    <li class="col"><i class="fa fa-check text-success me-1"></i> Hỗ trợ trả góp 0%</li>
                </ul>
            </div>

            <div class="policy-box mb-4">
                <h6 class="fw-bold text-orange mb-3"><i class="fa fa-gift me-2"></i>ƯU ĐÃI ĐẶC QUYỀN</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>Tặng Balo Gaming cao cấp trị giá 500k</span>
                    </div>
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>Giảm thêm <strong>200k</strong> khi mua kèm màn hình</span>
                    </div>
                    <div class="gift-item d-flex gap-2">
                        <i class="fa fa-check-circle text-success mt-1"></i>
                        <span>Hỗ trợ cài đặt phần mềm trọn đời</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mb-4">
                <div class="flex-grow-1">
                    <button class="btn btn-danger w-100 py-3 text-uppercase fw-bold">
                        <span class="fs-5 d-block">Mua ngay</span>
                        <span class="small fw-normal">Giao hàng tận nơi hoặc nhận tại cửa hàng</span>
                    </button>
                </div>
                <div>
                    <button class="btn btn-outline-warning py-3 px-4 d-flex flex-column align-items-center h-100 justify-content-center">
                        <i class="fa fa-cart-plus fs-4"></i>
                        <span class="small fw-bold mt-1">Thêm giỏ</span>
                    </button>
                </div>
            </div>

            <div class="border rounded p-3 bg-white shadow-sm">
                <div class="row text-center row-cols-3 small">
                    <div class="col">
                        <i class="fa fa-shield-alt text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">Bảo hành uy tín</div>
                    </div>
                    <div class="col border-start border-end">
                        <i class="fa fa-sync text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">Đổi trả 15 ngày</div>
                    </div>
                    <div class="col">
                        <i class="fa fa-truck text-orange fs-5 mb-1"></i>
                        <div class="fw-bold">Free Shipping</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="bg-white p-4 rounded shadow-sm">

                <ul class="nav nav-tabs mb-4" id="productTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fs-5" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button">Mô tả sản phẩm</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fs-5" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button">Thông số kỹ thuật</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fs-5" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button">Đánh giá (0)</button>
                    </li>
                </ul>

                <div class="tab-content" id="productTabContent">

                    <div class="tab-pane fade show active" id="desc">
                        <div class="content-body text-secondary" style="line-height: 1.8;">
                            <h5 class="fw-bold text-dark mb-3">Đánh giá chi tiết @Model.Name</h5>
                            <p>@Model.Description</p>
                            <p>Sản phẩm <strong>@Model.Name</strong> mang đến hiệu năng vượt trội với thiết kế hiện đại...</p>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="specs">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <h5 class="fw-bold mb-3">Cấu hình chi tiết</h5>
                                <table class="table table-striped table-hover tech-specs-table border">
                                    <tbody>
                                        <tr>
                                            <th>Thương hiệu</th>
                                            <td>@Model.Brand?.BrandName</td>
                                        </tr>
                                        <tr>
                                            <th>Tên sản phẩm</th>
                                            <td>@Model.Name</td>
                                        </tr>
                                        <tr>
                                            <th>Bảo hành</th>
                                            <td>12 Tháng</td>
                                        </tr>
                                        <tr>
                                            <th>Màu sắc</th>
                                            <td>Đen / Xám</td>
                                        </tr>
                                        <tr>
                                            <th>Chất liệu</th>
                                            <td>Nhôm nguyên khối</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>



                    
                    @* <div class="tab-pane fade" id="review">
                        <div class="text-center py-5">
                            <i class="fa fa-comment-dots fa-3x text-muted mb-3 opacity-25"></i>
                            <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
                            <button class="btn btn-orange">Viết đánh giá ngay</button>
                        </div>
                    </div> *@

                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h4 class="fw-bold mb-4">Sản phẩm liên quan</h4>
    </div>

</div>