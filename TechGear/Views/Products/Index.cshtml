@model IEnumerable<TechGear.Models.Product>

@{
    ViewData["Title"] = "Tất cả sản phẩm";
}

<div class="container my-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="text-decoration-none text-muted">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active fw-bold">Sản phẩm</li>
        </ol>
    </nav>

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">Tất cả sản phẩm</h1>
            <small class="text-muted">
                Có <strong>@Model.Count()</strong> sản phẩm
            </small>
        </div>

        <select class="form-select form-select-sm w-auto">
            <option selected>Mới nhất</option>
            <option>Giá thấp → cao</option>
            <option>Giá cao → thấp</option>
        </select>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">

            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card product-card h-100 border-0 shadow-sm">

                        <!-- IMAGE -->
                        <a asp-action="Details" asp-route-id="@item.Id">
                            <img src="@item.ImageUrl"
                                 class="card-img-top p-3"
                                 alt="@item.Name">
                        </a>

                        <!-- BODY -->
                        <div class="card-body d-flex flex-column">

                            <small class="text-muted text-uppercase mb-1">
                                @item.BrandName
                            </small>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="fw-bold text-dark text-decoration-none mb-2"
                               style="height: 2.8em; overflow: hidden">
                                @item.Name
                            </a>

                            <small class="text-secondary mb-2">
                                @item.CategoryName
                            </small>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning w-100">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fa fa-box-open fa-3x mb-3"></i>
            <h5>Chưa có sản phẩm</h5>
        </div>
    }
</div>
