@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "_Layout";
}

<style>
    .auth-container {
        max-width: 500px;
        margin: 50px auto;
    }

    .auth-card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .auth-header {
        background: linear-gradient(135deg, #ff6a00 0%, #ee0979 100%);
        padding: 30px;
        text-align: center;
        color: white;
    }

        .auth-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 1.8rem;
        }

        .auth-header p {
            margin: 8px 0 0 0;
            opacity: 0.95;
            font-size: 0.95rem;
        }

    .auth-body {
        padding: 40px 35px;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #ff6a00;
            box-shadow: 0 0 0 0.2rem rgba(255, 106, 0, 0.15);
        }

    .btn-register {
        background: linear-gradient(135deg, #ff6a00 0%, #ee0979 100%);
        border: none;
        color: white;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        transition: transform 0.2s ease, box-shadow 0.3s ease;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 106, 0, 0.4);
            color: white;
        }

    .alert {
        border-radius: 8px;
        border: none;
    }

    .text-orange {
        color: #ff6a00;
    }

    .link-orange {
        color: #ff6a00;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

        .link-orange:hover {
            color: #ee0979;
            text-decoration: underline;
        }

    .form-check-input:checked {
        background-color: #ff6a00;
        border-color: #ff6a00;
    }

    .password-strength {
        height: 5px;
        background: #e0e0e0;
        border-radius: 5px;
        margin-top: 8px;
        overflow: hidden;
    }

        .password-strength .strength-bar {
            height: 100%;
            transition: width 0.3s ease;
        }

    .benefits-list {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-top: 25px;
    }

        .benefits-list h6 {
            color: #ff6a00;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .benefits-list li {
            padding: 8px 0;
            color: #555;
            font-size: 0.9rem;
        }

            .benefits-list li i {
                color: #ff6a00;
                margin-right: 10px;
                width: 20px;
            }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2><i class="fa fa-user-plus me-2"></i>Đăng ký tài khoản</h2>
            <p>Trở thành thành viên của TechGear ngay hôm nay</p>
        </div>

        <div class="auth-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <i class="fa fa-check-circle me-2"></i>
                    <div>@ViewBag.Success</div>
                </div>
            }

            <form method="post" asp-action="Register">
                <div class="mb-3">
                    <label class="form-label">
                        <i class="fa fa-user me-1"></i>Họ và tên
                    </label>
                    <input type="text" class="form-control" name="FullName" placeholder="Nhập họ và tên đầy đủ" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        <i class="fa fa-envelope me-1"></i>Email
                    </label>
                    <input type="email" class="form-control" name="Email" placeholder="Nhập địa chỉ email" required />
                    <small class="text-muted">Email sẽ được dùng để đăng nhập</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        <i class="fa fa-phone me-1"></i>Số điện thoại
                    </label>
                    <input type="tel" class="form-control" name="PhoneNumber" placeholder="Nhập số điện thoại" pattern="[0-9]{10,11}" />
                    <small class="text-muted">Ví dụ: 0123456789</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        <i class="fa fa-lock me-1"></i>Mật khẩu
                    </label>
                    <input type="password" class="form-control" name="Password" id="password" placeholder="Tạo mật khẩu mạnh" required minlength="6" />
                    <div class="password-strength">
                        <div class="strength-bar bg-danger" id="strengthBar" style="width: 0%"></div>
                    </div>
                    <small class="text-muted">Tối thiểu 6 ký tự</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        <i class="fa fa-lock me-1"></i>Xác nhận mật khẩu
                    </label>
                    <input type="password" class="form-control" name="ConfirmPassword" placeholder="Nhập lại mật khẩu" required />
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                    <label class="form-check-label small" for="agreeTerms">
                        Tôi đồng ý với <a href="#" class="link-orange">Điều khoản dịch vụ</a> và <a href="#" class="link-orange">Chính sách bảo mật</a>
                    </label>
                </div>

                <button type="submit" class="btn btn-register">
                    <i class="fa fa-user-plus me-2"></i>Đăng ký tài khoản
                </button>
            </form>

            <div class="benefits-list">
                <h6><i class="fa fa-gift me-2"></i>Lợi ích thành viên</h6>
                <ul class="list-unstyled mb-0">
                    <li><i class="fa fa-check-circle"></i>Tích điểm mỗi giao dịch</li>
                    <li><i class="fa fa-check-circle"></i>Nhận voucher giảm giá độc quyền</li>
                    <li><i class="fa fa-check-circle"></i>Ưu đãi đặc biệt dịp lễ</li>
                    <li><i class="fa fa-check-circle"></i>Hỗ trợ bảo hành nhanh chóng</li>
                </ul>
            </div>

            <div class="text-center mt-4">
                <span class="text-muted">Đã có tài khoản?</span>
                <a asp-action="Login" class="link-orange ms-1">Đăng nhập ngay</a>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
            <i class="fa fa-arrow-left me-2"></i>Quay về trang chủ
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Password strength indicator
        document.getElementById('password').addEventListener('input', function(e) {
            const password = e.target.value;
            const strengthBar = document.getElementById('strengthBar');
            let strength = 0;

            if (password.length >= 6) strength += 25;
            if (password.length >= 10) strength += 25;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 25;
            if (/[0-9]/.test(password) && /[^A-Za-z0-9]/.test(password)) strength += 25;

            strengthBar.style.width = strength + '%';

            if (strength <= 25) {
                strengthBar.className = 'strength-bar bg-danger';
            } else if (strength <= 50) {
                strengthBar.className = 'strength-bar bg-warning';
            } else if (strength <= 75) {
                strengthBar.className = 'strength-bar bg-info';
            } else {
                strengthBar.className = 'strength-bar bg-success';
            }
        });
    </script>
}
