@model IEnumerable<TechGear.Models.Category>

@* This component needs to be redesigned to work with ViewModels *@
@* Categories no longer have Products navigation property *@

<div class="dropdown-menu mega-menu p-4">
    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-3">
                <h6 class="fw-bold text-orange">
                    <a href="/Products/ByCategory/@category.CategoryId" class="text-decoration-none text-orange">
                        @category.CategoryName
                    </a>
                </h6>

                @if (category.ProductCount.HasValue && category.ProductCount > 0)
                {
                    <p class="small text-muted">
                        @category.ProductCount sản phẩm
                    </p>
                }

                @* Brand filtering will be handled differently via API *@
                @* This section needs controller support to get brands per category *@
            </div>
        }
    </div>
</div>
