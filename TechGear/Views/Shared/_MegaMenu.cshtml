@model IEnumerable<TechGear.Models.Category>

<div class="dropdown-menu mega-menu p-4">
    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-3">
                <h6 class="fw-bold text-orange">
                    @category.CategoryName
                </h6>

                <ul class="list-unstyled">
                    @foreach (var brand in category.Products
                                    .Select(p => p.Brand)
                                    .Distinct())
                    {
                        <li>
                            <a class="dropdown-item"
                               href="/Products?category=@category.CategoryId&brand=@brand.BrandId">
                                @brand.BrandName
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
