@model TechGear.Models.Brand

@* @{
    ViewData["Title"] = "Chi tiết thương hiệu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Sử dụng Layout Admin
} *@

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Brands">Thương hiệu</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary">
                        <i class="fa fa-info-circle me-2"></i> Thông tin chi tiết
                    </h5>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success"><i class="fa fa-check"></i> Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="fa fa-ban"></i> Ngừng hoạt động</span>
                    }
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-4 text-center border-end">
                            <h6 class="text-muted fw-bold mb-3 text-uppercase small">Logo Thương Hiệu</h6>
                            <div class="p-3 bg-light rounded d-flex align-items-center justify-content-center" style="min-height: 200px;">
                                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                {
                                    <img src="@Model.LogoUrl" alt="@Model.BrandName" class="img-fluid" style="max-height: 150px; object-fit: contain;">
                                }
                                else
                                {
                                    <div class="text-muted">
                                        <i class="fa fa-image fa-3x mb-2"></i>
                                        <p>Chưa cập nhật logo</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                            <div class="mb-4">
                                <label class="text-muted small text-uppercase fw-bold">Tên thương hiệu</label>
                                <h2 class="fw-bold text-dark">@Model.BrandName</h2>
                            </div>

                            <div class="mb-4">
                                <label class="text-muted small text-uppercase fw-bold">Mô tả</label>
                                <div class="p-3 bg-light rounded mt-1 text-secondary">
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="fst-italic">Chưa có mô tả cho thương hiệu này.</span>
                                    }
                                </div>
                            </div>

                            <div class="mb-2 text-end">
                                <small class="text-muted">ID Hệ thống: #@Model.BrandId</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white py-3">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.BrandId" class="btn text-white fw-bold" style="background-color: #ff6a00;">
                            <i class="fa fa-edit me-1"></i> Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>