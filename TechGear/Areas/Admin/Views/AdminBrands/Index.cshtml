@model IEnumerable<TechGear.Models.Brand>

<style>
    .btn-orange {
        background-color: #ff6a00;
        color: white;
        border: none;
    }

        .btn-orange:hover {
            background-color: #e65100;
            color: white;
        }

    .logo-thumbnail {
        height: 40px;
        width: auto;
        object-fit: contain;
        border-radius: 4px;
        border: 1px solid #eee;
        padding: 2px;
        background: #fff;
    }

    .truncate-desc {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Danh sách Thương hiệu</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/Admin/Dashboard" class="text-decoration-none text-muted">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Thương hiệu</li>
                </ol>
            </nav>
        </div>

        <a asp-action="Create" class="btn btn-orange shadow-sm px-4">
            <i class="fa fa-plus-circle me-2"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Logo</th>
                            <th>Tên thương hiệu</th>
                            <th>Mô tả</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool isLocked = item.Products != null && item.Products.Any();

                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(item.LogoUrl))
                                    {
                                        <img src="@item.LogoUrl" alt="@item.BrandName" class="logo-thumbnail" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">
                                            <i class="fa fa-image"></i> No Logo
                                        </span>
                                    }
                                </td>

                                <td class="fw-bold text-dark">
                                    @item.BrandName
                                </td>

                                <td>
                                    <div class="truncate-desc" title="@item.Description">
                                        @item.Description
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 border border-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 border border-secondary">
                                            Đã ẩn
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        @if (!isLocked)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.BrandId"
                                               class="btn btn-sm btn-white border text-primary"
                                               title="Sửa">
                                                <i class="fa fa-edit"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.BrandId"
                                               class="btn btn-sm btn-white border text-danger"
                                               title="Xóa">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary" disabled
                                                    title="Thương hiệu đã được sử dụng cho sản phẩm">
                                                <i class="fa fa-lock me-1"></i> Locked
                                            </button>
                                        }

                                        <a asp-action="Details"
                                           asp-route-id="@item.BrandId"
                                           class="btn btn-sm btn-white border text-info"
                                           title="Chi tiết">
                                            <i class="fa fa-info-circle"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-copyright fa-3x mb-3 opacity-50"></i>
                    <p class="mb-0">Chưa có thương hiệu nào.</p>
                    <a asp-action="Create" class="small text-decoration-none">
                        Thêm thương hiệu ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>
