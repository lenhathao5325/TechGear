@model TechGear.Models.Brand

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Brands">Thương hiệu</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="m-0 fw-bold text-primary">
                        <i class="fa fa-edit me-1"></i> Cập nhật thương hiệu: @Model.BrandName
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="BrandId" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="BrandName" class="form-label fw-bold"></label>
                                    <input asp-for="BrandName" class="form-control" />
                                    <span asp-validation-for="BrandName" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <label asp-for="Description" class="form-label fw-bold mb-0"></label>
                                        <button type="button" id="btnGenDesc" class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-magic me-1"></i>Tạo mô tả tự động
                                        </button>
                                    </div>
                                    <textarea asp-for="Description" class="form-control" rows="4"
                                              id="descriptionField"></textarea>
                                    <div id="genDescStatus" class="small mt-1" style="display:none"></div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Trạng thái</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox"
                                               id="activeSwitch">
                                        <label class="form-check-label" for="activeSwitch">
                                            @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 text-center">
                                <label class="form-label fw-bold">Logo</label>
                                <div class="border rounded bg-light d-flex align-items-center justify-content-center"
                                     style="height:200px;">
                                    <img src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "/images/no-image.svg" : Model.LogoUrl)"
                                         style="max-width:90%; max-height:90%; object-fit:contain;" />
                                </div>
                                <small class="text-muted d-block mt-2">Logo không thể chỉnh sửa tại đây</small>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn text-white fw-bold" style="background-color:#ff6a00;">
                                <i class="fa fa-save"></i> Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('activeSwitch')?.addEventListener('change', function () {
            this.nextElementSibling.innerText = this.checked ? "Đang hoạt động" : "Ngừng hoạt động";
        });

        document.getElementById('btnGenDesc').addEventListener('click', async function () {
            const name = document.querySelector('[name="BrandName"]').value.trim();
            if (!name) {
                showGenStatus('warning', '<i class="fa fa-exclamation-triangle me-1"></i>Vui lòng nhập tên thương hiệu trước.');
                return;
            }
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Đang tạo...';
            try {
                const res = await fetch('http://localhost:5089/api/generate-description/brand', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                if (!res.ok) throw new Error();
                const data = await res.json();
                document.getElementById('descriptionField').value = data.description;
                showGenStatus('success', '<i class="fa fa-check-circle me-1"></i>Mô tả đã được tạo. Bạn có thể chỉnh sửa thêm.');
            } catch {
                showGenStatus('danger', '<i class="fa fa-times-circle me-1"></i>Không thể tạo mô tả. Vui lòng thử lại.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-magic me-1"></i>Tạo mô tả tự động';
            }
        });
        function showGenStatus(type, html) {
            const el = document.getElementById('genDescStatus');
            el.className = 'small mt-1 text-' + type;
            el.innerHTML = html;
            el.style.display = html ? '' : 'none';
        }
    </script>
}
