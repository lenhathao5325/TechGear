@model IEnumerable<TechGear.Models.Combo>
@{
    ViewData["Title"] = "Quản lý Combo";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title">
        <i class="bi bi-bundle"></i>
        Quản lý Combo
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="admin-breadcrumb">
            <li class="breadcrumb-item"><a href="#">Admin</a></li>
            <li class="breadcrumb-item active">Combo</li>
        </ol>
    </nav>
</div>

<div class="ps-3 pe-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div></div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i>
            Tạo combo mới
        </a>
    </div>

    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Tên Combo</th>
                    <th width="120" class="text-end">Giá gốc</th>
                    <th width="120" class="text-end">Giá bán</th>
                    <th width="120" class="text-center">Trạng thái</th>
                    <th width="120" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach(var c in Model)
                    {
                        <tr>
                            <td><strong>@c.ComboName</strong></td>
                            <td class="text-end text-muted">@c.OriginalPrice.ToString("C")</td>
                            <td class="text-end fw-bold text-success">@c.FinalPrice.ToString("C")</td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-success">
                                        <i class="bi bi-check-circle"></i>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        <i class="bi bi-x-circle"></i>
                                        Không hoạt động
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="table-actions">
                                    <a class="btn-edit" asp-action="Edit" asp-route-id="@c.ComboId" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn-view" asp-action="Details" asp-route-id="@c.ComboId" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn-delete" asp-action="Delete" asp-route-id="@c.ComboId" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size: 48px; color: #d1d5db;"></i>
                            <p class="mt-2 text-muted">Không có combo nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
