@model IEnumerable<TechGear.Models.Combo>
@{
    ViewData["Title"] = "Quản lý Combo";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title">
        <i class="bi bi-bundle"></i>
        Quản lý Combo
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="admin-breadcrumb">
            <li class="breadcrumb-item"><a href="#">Admin</a></li>
            <li class="breadcrumb-item active">Combo</li>
        </ol>
    </nav>
</div>

<div class="ps-3 pe-3">
    @await Html.PartialAsync("~/Views/Shared/_AdminListToolbar.cshtml")

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div></div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i>
            Tạo combo mới
        </a>
    </div>

    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Tên Combo</th>
                    <th width="120" class="text-end">Giá gốc</th>
                    <th width="120" class="text-end">Giá bán</th>
                    <th width="120" class="text-center">Trạng thái</th>
                    <th width="120" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach(var item in Model)
                    {
                        <tr>
                            <td><strong>@item.ComboName</strong></td>
                            <td class="text-end text-muted">@item.OriginalPrice.ToString("C")</td>
                            <td class="text-end fw-bold text-success">@item.FinalPrice.ToString("C")</td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">
                                        <i class="bi bi-check-circle"></i>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        <i class="bi bi-x-circle"></i>
                                        Không hoạt động
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="table-actions">
                                    <a class="btn-edit" asp-action="Edit" asp-route-id="@item.ComboId" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn-view" asp-action="Details" asp-route-id="@item.ComboId" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn-delete" asp-action="Delete" asp-route-id="@item.ComboId" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size: 48px; color: #d1d5db;"></i>
                            <p class="mt-2 text-muted">Không có combo nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{ 
        var q = Context.Request.Query;
        var search = (q["search"].ToString() ?? string.Empty).Trim();
        var status = q["status"].ToString() ?? string.Empty;
        var pageSize = q["pageSize"].ToString(); if (string.IsNullOrEmpty(pageSize)) pageSize = "10";

        int page = 1;
        int parsedPage = 0;
        int.TryParse(q["page"].ToString(), out parsedPage);
        if (parsedPage > 0) page = parsedPage;

        int totalPages = ViewData["TotalPages"] as int? ?? 1;
        var action = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : string.Empty;
        var controller = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : string.Empty;
        var area = ViewContext.RouteData.Values["area"] != null ? ViewContext.RouteData.Values["area"].ToString() : string.Empty;
        int start = Math.Max(1, page - 2);
        int end = Math.Min(totalPages, page + 2);
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-3">
            <ul class="pagination pagination-sm justify-content-end">
                <li class="page-item @(page==1? "disabled":"")">
                    <a class="page-link" href="@Url.Action(action, controller, new { area = area, page = page - 1, search = search, status = status, pageSize = pageSize })">&lsaquo;</a>
                </li>
                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i==page? "active":"")"><a class="page-link" href="@Url.Action(action, controller, new { area = area, page = i, search = search, status = status, pageSize = pageSize })">@i</a></li>
                }
                <li class="page-item @(page==totalPages? "disabled":"")">
                    <a class="page-link" href="@Url.Action(action, controller, new { area = area, page = page + 1, search = search, status = status, pageSize = pageSize })">&rsaquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
