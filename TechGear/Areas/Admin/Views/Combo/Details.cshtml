@model TechGear.Models.Combo
@{
    ViewData["Title"] = "Chi tiết combo";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title"><i class="bi bi-eye me-2"></i>Chi tiết combo</h1>
</div>

<div class="ps-3 pe-3">
    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card mb-4">
                <div class="card-header">
                    <i class="bi bi-box"></i>
                    <h5>@Model.ComboName</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <p class="text-muted"><i class="bi bi-chat-dots me-2"></i>Mô tả</p>
                        <p>@Model.Description</p>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <p class="text-muted"><i class="bi bi-cash-coin me-2"></i>Giá gốc</p>
                            <p><strong>@Model.OriginalPrice.ToString("C")</strong></p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted"><i class="bi bi-currency-dollar me-2"></i>Giá bán</p>
                            <p><strong>@Model.FinalPrice.ToString("C")</strong></p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted"><i class="bi bi-percent me-2"></i>Giảm giá</p>
                            <p><strong>@Model.DiscountValue</strong></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="card-header">
                    <i class="bi bi-box"></i>
                    <h5>Sản phẩm trong combo</h5>
                </div>
                <div class="card-body p-0">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>SKU</th>
                                <th class="text-center">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var ci in Model.ComboItems ?? new List<TechGear.Models.ComboItem>())
                            {
                                <tr>
                                    <td><strong>@ci.ProductVariant?.Product?.Name</strong></td>
                                    <td>@ci.ProductVariant?.SKU</td>
                                    <td class="text-center">@ci.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="form-actions mt-4">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ComboId"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ComboId"><i class="bi bi-trash me-2"></i>Xóa</a>
                <a class="btn btn-cancel" asp-action="Index"><i class="bi bi-x-circle me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>