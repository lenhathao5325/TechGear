@{
    ViewData["Title"] = "Tạo biến thể";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title"><i class="bi bi-plus-circle"></i> Tạo biến thể</h1>
</div>

<div class="ps-3 pe-3">
    <div class="admin-card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="ProductId" value="@ViewData["ProductId"]" />

                <div class="mb-3">
                    <label class="form-label">Tên biến thể</label>
                    <input name="Name" class="form-control" placeholder="Ví dụ: Màu Đen - Size M" />
                </div>

                <div class="mb-3">
                    <label class="form-label">SKU</label>
                    <input name="SKU" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Giá (VNĐ)</label>
                    <input name="Price" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Số lượng</label>
                    <input name="Stock" class="form-control" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>Tạo</button>
                    <a class="btn btn-cancel" asp-action="Index" asp-route-productId="@ViewData["ProductId"]"><i class="bi bi-x-circle me-2"></i>Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>