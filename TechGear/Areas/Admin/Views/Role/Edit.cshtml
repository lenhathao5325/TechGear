@model TechGear.Models.ApplicationUser
@{
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
    var userRoles = ViewBag.UserRoles as IList<string>;
}

<h3>Gán quyền - @Model.Email</h3>

<form method="post">
    <input type="hidden" name="userId" value="@Model.Id" />

    @{
        var canManageAdmin = ViewBag.CanManageAdminRole as bool? ?? false;
    }
    @foreach (var role in roles)
    {
        <div class="form-check mb-2">
            @{ var isAdminRole = string.Equals(role.Name, "Admin", StringComparison.OrdinalIgnoreCase); }
            @{ var isChecked = userRoles.Contains(role.Name) ? "checked" : string.Empty; }
            @{ var isDisabled = (isAdminRole && !canManageAdmin) ? "disabled" : string.Empty; }

            <input class="form-check-input" type="checkbox" name="roles" value="@role.Name" @isChecked @isDisabled />
            <label class="form-check-label">@role.Name @if(isAdminRole && !canManageAdmin){<text> <span class="text-muted">(không thể thay đổi)</span></text>}</label>
        </div>
    }

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
