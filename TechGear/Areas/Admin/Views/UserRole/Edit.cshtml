@model TechGear.Models.ApplicationUser
@{
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var currentRole = ViewBag.CurrentRole as string;
}

<h3>Gán vai trò - @Model.Email</h3>

<form method="post">
    <input type="hidden" name="userId" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Ch?n vai trò</label>
        <select name="selectedRole" class="form-select">
            <option value="">(Không có)</option>
            @foreach(var r in roles){
                if (string.Equals(r, currentRole))
                {
                    <option value="@r" selected>@r</option>
                }
                else
                {
                    <option value="@r">@r</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">L?u</button>
    <a class="btn btn-link" asp-action="Index">H?y</a>
</form>