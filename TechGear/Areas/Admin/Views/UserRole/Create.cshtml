@model TechGear.Models.ApplicationUser

<div class="admin-header">
    <div class="container-fluid">
        <h1><i class="bi bi-person-plus me-2"></i>Tạo người dùng</h1>
        <p class="text-muted">Thêm người dùng mới vào hệ thống</p>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-envelope me-2"></i>Email</label>
                            <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-person me-2"></i>Họ và tên</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-key me-2"></i>Mật khẩu</label>
                            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>Tạo</button>
                            <a class="btn btn-cancel" asp-action="Index"><i class="bi bi-x-circle me-2"></i>Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
