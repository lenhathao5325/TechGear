@model IEnumerable<TechGear.Models.ViewModels.UserRoleVM>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title">
        <i class="bi bi-people"></i>
        Quản lý Người dùng
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="admin-breadcrumb">
            <li class="breadcrumb-item"><a href="#">Admin</a></li>
            <li class="breadcrumb-item active">Người dùng</li>
        </ol>
    </nav>
</div>

<div class="ps-3 pe-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div></div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="UserRole" asp-action="Create">
            <i class="bi bi-plus-circle"></i>
            Tạo người dùng mới
        </a>
    </div>

    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th width="200">Vai trò</th>
                    <th width="120" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Email</strong></td>
                            <td>
                                @if (item.Roles != null && item.Roles.Any())
                                {
                                    @foreach (var role in item.Roles)
                                    {
                                        <span class="badge badge-primary me-1">
                                            <i class="bi bi-shield"></i>
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-secondary">
                                        <i class="bi bi-dash-circle"></i>
                                        Chưa có vai trò
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="table-actions">
                                    <a class="btn-edit" asp-area="Admin" asp-controller="UserRole" asp-action="Edit" asp-route-id="@item.UserId" title="Gán vai trò">
                                        <i class="bi bi-person-check"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size: 48px; color: #d1d5db;"></i>
                            <p class="mt-2 text-muted">Không có người dùng nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
