@model TechGear.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title"><i class="bi bi-receipt"></i> Chi tiết đơn hàng</h1>
</div>

<div class="ps-3 pe-3">
    <div class="admin-card mb-4">
        <div class="card-header">
            <i class="bi bi-receipt"></i>
            <h5>Đơn hàng #@Model.OrderId</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-muted mb-2"><i class="bi bi-calendar me-2"></i>Ngày đặt</p>
                    <p>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="text-muted mb-2"><i class="bi bi-person me-2"></i>Khách hàng</p>
                    <p><strong>@Model.User?.UserName</strong></p>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card mb-4">
        <div class="card-header">
            <i class="bi bi-pin-map"></i>
            <h5>Địa chỉ giao hàng</h5>
        </div>
        <div class="card-body">
            <p>@Model.UserAddress?.AddressLine</p>
        </div>
    </div>

    <div class="admin-card mb-4">
        <div class="card-header">
            <i class="bi bi-box"></i>
            <h5>Sản phẩm</h5>
        </div>
        <div class="card-body p-0">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-box"></i> Sản phẩm</th>
                        <th>Phiên bản</th>
                        <th>Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var d in Model.OrderDetails ?? new List<TechGear.Models.OrderDetail>())
                    {
                        <tr>
                            <td><strong>@d.ProductName</strong></td>
                            <td>@d.VariantDescription</td>
                            <td class="text-center">@d.Quantity</td>
                            <td class="text-end">@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", d.UnitPrice)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card">
        <div class="card-body">
            <div class="row text-end">
                <div class="col-md-6 offset-md-6">
                    <div class="mb-2">
                        <p class="text-muted">Tạm tính: <strong>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.SubTotal)</strong></p>
                        <p class="text-muted">Phí vận chuyển: <strong>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.ShippingFee)</strong></p>
                        <p class="text-muted" style="border-top: 1px solid #e0e0e0; padding-top: 10px; margin-top: 10px;">
                            <strong style="color: #0d6efd; font-size: 18px;">Tổng: @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.TotalAmount)</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="form-actions mt-3">
                <a class="btn btn-cancel" asp-action="Index"><i class="bi bi-x-circle me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>