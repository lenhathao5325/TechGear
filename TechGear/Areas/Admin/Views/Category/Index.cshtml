@model IEnumerable<TechGear.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title">
        <i class="bi bi-tag"></i>
        Quản lý Danh mục
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="admin-breadcrumb">
            <li class="breadcrumb-item"><a href="#">Admin</a></li>
            <li class="breadcrumb-item active">Danh mục</li>
        </ol>
    </nav>
</div>

<div class="ps-3 pe-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div></div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i>
            Thêm danh mục mới
        </a>
    </div>

    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th width="50">ID</th>
                    <th>Tên danh mục</th>
                    <th width="120" class="text-center">Kích hoạt</th>
                    <th width="120" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach(var c in Model)
                    {
                        <tr>
                            <td><span class="badge badge-primary">@c.CategoryId</span></td>
                            <td><strong>@c.CategoryName</strong></td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-success">
                                        <i class="bi bi-check-circle"></i>
                                        Kích hoạt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        <i class="bi bi-x-circle"></i>
                                        Vô hiệu hóa
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="table-actions">
                                    <a class="btn-edit" asp-action="Edit" asp-route-id="@c.CategoryId" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn-delete" asp-action="Delete" asp-route-id="@c.CategoryId" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size: 48px; color: #d1d5db;"></i>
                            <p class="mt-2 text-muted">Không có danh mục nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>