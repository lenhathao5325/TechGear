@model TechGear.Models.Category
@{
    ViewData["Title"] = "Xóa danh m?c";
}

<h3>Xác nh?n xóa</h3>
<div class="card">
    <div class="card-body">
        <h5>@Model.CategoryName</h5>
        <p class="text-muted">@Model.Description</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.CategoryId" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a class="btn btn-link" asp-action="Index">H?y</a>
        </form>
    </div>
</div>