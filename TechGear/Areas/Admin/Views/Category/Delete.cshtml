@model TechGear.Models.Category
@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="admin-header">
    <div class="container-fluid">
        <h1><i class="bi bi-trash-fill me-2"></i>Xóa danh mục</h1>
        <p class="text-muted">Xác nhận xóa danh mục khỏi hệ thống</p>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="card-header">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    <h3>Xác nhận xóa</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Cảnh báo!</strong> Hành động này không thể hoàn tác.
                    </div>
                    <h5><i class="bi bi-tag me-2"></i>@Model.CategoryName</h5>
                    <p class="text-muted mb-3">@Model.Description</p>

                    <form asp-action="Delete" method="post" class="form-actions">
                        <input type="hidden" name="id" value="@Model.CategoryId" />
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Xóa</button>
                        <a class="btn btn-cancel" asp-action="Index"><i class="bi bi-x-circle me-2"></i>Hủy</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>