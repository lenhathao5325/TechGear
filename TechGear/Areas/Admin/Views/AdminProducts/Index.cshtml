@model IEnumerable<TechGear.Models.Product>

@* @{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Kết nối với Layout Admin
} *@

<style>
    /* CSS riêng để cắt gọn mô tả dài */
    .truncate-text {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-orange {
        background-color: #ff6a00;
        color: white;
        border: none;
    }

        .btn-orange:hover {
            background-color: #e65100;
            color: white;
        }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Quản lý sản phẩm</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sản phẩm</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Create" class="btn btn-orange shadow-sm px-4">
            <i class="fa fa-plus-circle me-2"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Category)</th>
                            <th>@Html.DisplayNameFor(model => model.Brand)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark bg-opacity-10 border border-info px-3">
                                        @(item.Category != null ? item.Category.CategoryName : "N/A")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark bg-opacity-10 border border-warning px-3">
                                        @(item.Brand != null ? item.Brand.BrandName : "N/A")
                                    </span>
                                </td>
                                <td>
                                    <div class="truncate-text" title="@item.Description">
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <img src="@item.ImageUrl" width="80" class="img-thumbnail" />
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="fa fa-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-box-open fa-3x mb-3"></i>
                    <p>Chưa có sản phẩm nào.</p>
                </div>
            }
        </div>
    </div>
</div>