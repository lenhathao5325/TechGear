@model TechGear.Models.Category

@* @{
    ViewData["Title"] = "Chi tiết danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Sử dụng Layout Admin
} *@

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Categories">Danh mục</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary">
                        <i class="fa fa-info-circle me-2"></i> Thông tin danh mục
                    </h5>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success"><i class="fa fa-check"></i> Đang hiển thị</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="fa fa-eye-slash"></i> Đang ẩn</span>
                    }
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
                            <i class="fa fa-folder-open text-warning fa-3x"></i>
                        </div>
                        <h2 class="fw-bold text-dark">@Model.CategoryName</h2>
                        <p class="text-muted small">ID Danh mục: #@Model.CategoryId</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="border rounded p-3 bg-light h-100">
                                <label class="text-uppercase text-muted small fw-bold mb-2">
                                    <i class="fa fa-align-left me-1"></i> Mô tả chi tiết
                                </label>
                                <div class="text-secondary">
                                    @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả cho danh mục này." : Model.Description)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <label class="text-uppercase text-muted small fw-bold mb-1">
                                    <i class="fa fa-calendar-alt me-1"></i> Ngày tạo
                                </label>
                                <div class="fs-5 fw-bold text-dark">
                                    @Model.CreatedAt.ToString("dd/MM/yyyy")
                                </div>
                                <small class="text-muted">Lúc @Model.CreatedAt.ToString("HH:mm")</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <label class="text-uppercase text-muted small fw-bold mb-1">
                                    <i class="fa fa-toggle-on me-1"></i> Trạng thái
                                </label>
                                <div>
                                    @if (Model.IsActive)
                                    {
                                        <span class="text-success fw-bold">
                                            <i class="fa fa-check-circle"></i> Kích hoạt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fw-bold">
                                            <i class="fa fa-times-circle"></i> Vô hiệu hóa
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white py-3">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn text-white fw-bold" style="background-color: #ff6a00;">
                            <i class="fa fa-edit me-1"></i> Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>