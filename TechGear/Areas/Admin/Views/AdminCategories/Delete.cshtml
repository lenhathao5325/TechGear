@model TechGear.Models.Category

@* @{
    ViewData["Title"] = "Xóa danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Sử dụng Layout Admin
} *@

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Categories">Danh mục</a></li>
            <li class="breadcrumb-item active text-danger" aria-current="page">Xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="m-0 fw-bold">
                        <i class="fa fa-exclamation-triangle me-2"></i> Xác nhận xóa danh mục
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning text-center" role="alert">
                        <strong>Cảnh báo quan trọng!</strong><br>
                        Nếu xóa danh mục này, các sản phẩm thuộc danh mục có thể bị lỗi hiển thị. Bạn có chắc chắn muốn tiếp tục?
                    </div>

                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="d-inline-block p-3 rounded-circle bg-light text-danger">
                                <i class="fa fa-folder-minus fa-3x"></i>
                            </span>
                        </div>

                        <h2 class="fw-bold text-dark">@Model.CategoryName</h2>

                        <div class="d-flex justify-content-center gap-2 mt-2">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã ẩn</span>
                            }
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded border">
                        <div class="row mb-2">
                            <div class="col-4 fw-bold text-secondary">Mô tả:</div>
                            <div class="col-8">
                                @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 fw-bold text-secondary">Ngày tạo:</div>
                            <div class="col-8 font-monospace">
                                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <form asp-action="Delete" class="d-flex justify-content-end gap-2">
                        <input type="hidden" asp-for="CategoryId" />

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-times me-1"></i> Hủy bỏ
                        </a>

                        <button type="submit" class="btn btn-danger fw-bold">
                            <i class="fa fa-trash-alt me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>