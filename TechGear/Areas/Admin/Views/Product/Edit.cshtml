@model TechGear.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="admin-page-header ps-3 pe-3">
    <h1 class="admin-page-title"><i class="bi bi-pencil me-2"></i>Sửa sản phẩm</h1>
    <p class="text-muted">Cập nhật thông tin sản phẩm</p>
</div>

<div class="ps-3 pe-3">
    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-tag me-2"></i>Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-chat-dots me-2"></i>Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả chi tiết sản phẩm"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label"><i class="bi bi-list me-2"></i>Danh mục</label>
                                    @{
                                        var categories = ViewBag.Categories as List<TechGear.Models.Category> ?? new List<TechGear.Models.Category>();
                                    }
                                    <select name="CategoryId" class="form-select">
                                        <option value="">-- Chọn --</option>
                                        @foreach(var c in categories)
                                        {
                                            if (c.CategoryId == Model.CategoryId)
                                            {
                                                <option value="@c.CategoryId" selected>@c.CategoryName</option>
                                            }
                                            else
                                            {
                                                <option value="@c.CategoryId">@c.CategoryName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label"><i class="bi bi-briefcase me-2"></i>Thương hiệu</label>
                                    @{
                                        var brands = ViewBag.Brands as List<TechGear.Models.Brand> ?? new List<TechGear.Models.Brand>();
                                    }
                                    <select name="BrandId" class="form-select">
                                        <option value="">-- Chọn --</option>
                                        @foreach(var b in brands)
                                        {
                                            if (b.BrandId == Model.BrandId)
                                            {
                                                <option value="@b.BrandId" selected>@b.BrandName</option>
                                            }
                                            else
                                            {
                                                <option value="@b.BrandId">@b.BrandName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-image me-2"></i>Hình ảnh</label>
                            <div class="upload-area border-2 border-dashed p-4 rounded text-center" style="cursor: pointer; border-color: #dee2e6; transition: all 0.3s ease;">
                                <i class="bi bi-cloud-upload" style="font-size: 2rem; color: #6c757d; margin-bottom: 10px;"></i>
                                <p class="text-muted mb-1">Kéo hình ảnh vào đây hoặc nhấp để chọn</p>
                                <small class="text-muted">PNG, JPG, GIF (tối đa 5MB)</small>
                                <input type="file" name="images" class="d-none" accept="image/*" />
                            </div>
                        </div>

                        <div class="form-actions mt-4">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-2"></i>Lưu</button>
                            <a class="btn btn-cancel" asp-action="Index"><i class="bi bi-x-circle me-2"></i>Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>