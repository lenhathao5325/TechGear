@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="admin-header">
    <div class="container-fluid">
        <div>
            <h1><i class="bi bi-graph-up me-2"></i>Dashboard</h1>
            <p class="text-muted">Tổng quan hệ thống TechGear</p>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted mb-2"><i class="bi bi-cash-coin me-2"></i>Doanh thu</p>
                            <h3 class="mb-0">45.2M đ</h3>
                            <small class="text-success"><i class="bi bi-graph-up"></i> +12% tháng này</small>
                        </div>
                        <div style="font-size: 3rem; color: #0d6efd; opacity: 0.2;">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted mb-2"><i class="bi bi-bag-fill me-2"></i>Đơn hàng</p>
                            <h3 class="mb-0">284</h3>
                            <small class="text-info"><i class="bi bi-box-seam"></i> 12 chưa xử lý</small>
                        </div>
                        <div style="font-size: 3rem; color: #198754; opacity: 0.2;">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted mb-2"><i class="bi bi-box me-2"></i>Sản phẩm</p>
                            <h3 class="mb-0">156</h3>
                            <small class="text-warning"><i class="bi bi-exclamation-lg"></i> 8 sắp hết</small>
                        </div>
                        <div style="font-size: 3rem; color: #ffc107; opacity: 0.2;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted mb-2"><i class="bi bi-people me-2"></i>Người dùng</p>
                            <h3 class="mb-0">1,234</h3>
                            <small class="text-secondary"><i class="bi bi-person-check"></i> 98% hoạt động</small>
                        </div>
                        <div style="font-size: 3rem; color: #0dcaf0; opacity: 0.2;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders & Low Stock -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="card-header">
                    <i class="bi bi-bag-check"></i>
                    <h3>Đơn hàng gần đây</h3>
                </div>
                <div class="card-body p-0">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-hash"></i> #</th>
                                <th><i class="bi bi-person"></i> Khách hàng</th>
                                <th><i class="bi bi-cash"></i> Tổng tiền</th>
                                <th><i class="bi bi-info-circle"></i> Trạng thái</th>
                                <th><i class="bi bi-calendar"></i> Ngày</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>#ORD001</strong></td>
                                <td>Nguyễn Văn A</td>
                                <td>1.2M đ</td>
                                <td><span class="admin-badge badge-active"><i class="bi bi-check-circle"></i> Hoàn thành</span></td>
                                <td>29/01/2026</td>
                            </tr>
                            <tr>
                                <td><strong>#ORD002</strong></td>
                                <td>Trần Thị B</td>
                                <td>850K đ</td>
                                <td><span class="admin-badge badge-pending"><i class="bi bi-clock"></i> Chờ xử lý</span></td>
                                <td>29/01/2026</td>
                            </tr>
                            <tr>
                                <td><strong>#ORD003</strong></td>
                                <td>Lê Văn C</td>
                                <td>2.5M đ</td>
                                <td><span class="admin-badge badge-active"><i class="bi bi-check-circle"></i> Hoàn thành</span></td>
                                <td>28/01/2026</td>
                            </tr>
                            <tr>
                                <td><strong>#ORD004</strong></td>
                                <td>Phạm Thị D</td>
                                <td>650K đ</td>
                                <td><span class="admin-badge badge-pending"><i class="bi bi-clock"></i> Chờ xử lý</span></td>
                                <td>28/01/2026</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-admin btn-admin-outline">
                        <i class="bi bi-arrow-right"></i> Xem tất cả đơn hàng
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-card">
                <div class="card-header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Sản phẩm sắp hết</h3>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <span><i class="bi bi-box text-primary"></i> Laptop Dell XPS 15</span>
                            <span class="admin-badge badge-inactive">3 còn lại</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <span><i class="bi bi-box text-primary"></i> iPhone 15 Pro Max</span>
                            <span class="admin-badge badge-inactive">5 còn lại</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <span><i class="bi bi-box text-primary"></i> MacBook Air M3</span>
                            <span class="admin-badge badge-inactive">2 còn lại</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-box text-primary"></i> iPad Pro 12.9"</span>
                            <span class="admin-badge badge-inactive">4 còn lại</span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-admin btn-admin-outline" style="width: 100%; justify-content: center;">
                        <i class="bi bi-arrow-right"></i> Quản lý kho
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
