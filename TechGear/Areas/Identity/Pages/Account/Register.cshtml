@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<style>
    /* CSS đồng bộ với trang Login */
    :root {
        --primary-orange: #ff6a00;
        --dark-orange: #e65100;
    }

    .register-container {
        margin-top: 30px;
        margin-bottom: 50px;
    }

    .register-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .register-header {
        background: linear-gradient(135deg, var(--primary-orange), #ff9f43);
        padding: 20px;
        text-align: center;
        color: white;
    }

        .register-header h3 {
            font-weight: 800;
            margin: 0;
            text-transform: uppercase;
            font-size: 1.5rem;
        }

        .register-header p {
            margin: 5px 0 0;
            font-size: 0.9rem;
            opacity: 0.9;
        }

    .btn-orange {
        background-color: var(--primary-orange);
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

        .btn-orange:hover {
            background-color: var(--dark-orange);
            color: white;
        }

    .input-group-text {
        background-color: #fff;
        color: #888;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .input-group:focus-within .input-group-text {
        border-color: var(--primary-orange);
        color: var(--primary-orange);
    }

    .form-control:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 0.25rem rgba(255, 106, 0, 0.25);
    }

    .link-orange {
        color: var(--primary-orange);
        text-decoration: none;
        font-weight: bold;
    }

        .link-orange:hover {
            text-decoration: underline;
            color: var(--dark-orange);
        }
</style>

<div class="container register-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card register-card">

                <div class="register-header">
                    <h3>Đăng Ký Thành Viên</h3>
                    <p>Tạo tài khoản để nhận ưu đãi từ TechGear</p>
                </div>

                <div class="card-body p-4">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label fw-bold text-secondary">Họ và tên</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-user"></i></span>
                                <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="Nhập họ tên của bạn..." />
                            </div>
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold text-secondary">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold text-secondary">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu..." />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-secondary">Xác nhận mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-check-circle"></i></span>
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu..." />
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn btn-orange w-100 py-2 mb-3 shadow-sm text-uppercase">
                            <i class="fa fa-user-plus me-1"></i> Đăng ký
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Bạn đã có tài khoản?</span>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="link-orange ms-1">Đăng nhập ngay</a>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="position-relative my-4">
                            <hr class="text-muted">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">Hoặc đăng ký bằng</span>
                        </div>

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="text-center">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary btn-sm m-1" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="fab fa-@provider.Name.ToLower()"></i> @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}