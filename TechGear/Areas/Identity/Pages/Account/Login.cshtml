@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page d-flex align-items-center justify-content-center">
    <div class="auth-card card p-4 shadow-sm">
        <div class="text-center mb-3">
            <i class="bi bi-lock-fill display-4 text-primary"></i>
            <h4 class="mt-2">Đăng nhập</h4>
            <p class="text-muted small">Đăng nhập để truy cập quản trị</p>
        </div>

        @await Html.PartialAsync("~/Views/Shared/_Alert.cshtml", ViewData["Alert"] as TechGear.Models.AlertModel)

        <form method="post" id="loginForm">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="your@email.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shield-lock-fill"></i></span>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" type="password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>
                <a asp-page="/Account/ForgotPassword" class="text-decoration-none"><i class="bi bi-question-circle me-1"></i>Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100" id="loginBtn">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </button>
        </form>

        <div class="text-center mt-3 small">
            Bạn chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // auto-hide alert after 5s
        setTimeout(function(){
            var a = document.querySelector('.custom-alert');
            if(a) a.style.display = 'none';
        }, 5000);

        // Add loading state on form submit
        document.getElementById('loginForm').addEventListener('submit', function() {
            var btn = document.getElementById('loginBtn');
            var card = document.querySelector('.auth-card');
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Đang đăng nhập...';
            card.classList.add('submitting');
        });
    </script>
}
