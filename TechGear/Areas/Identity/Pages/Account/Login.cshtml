@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    /* CSS riêng cho trang đăng nhập để đồng bộ màu Cam */
    :root {
        --primary-orange: #ff6a00;
        --dark-orange: #e65100;
    }

    .login-container {
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .login-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .login-header {
        background: linear-gradient(135deg, var(--primary-orange), #ff9f43);
        padding: 25px;
        text-align: center;
        color: white;
    }

        .login-header h3 {
            font-weight: 800;
            margin: 0;
            text-transform: uppercase;
        }

        .login-header p {
            margin: 5px 0 0;
            font-size: 0.9rem;
            opacity: 0.9;
        }

    .form-control:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 0.25rem rgba(255, 106, 0, 0.25);
    }

    .btn-orange {
        background-color: var(--primary-orange);
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

        .btn-orange:hover {
            background-color: var(--dark-orange);
            color: white;
        }

    .input-group-text {
        background-color: #fff;
        border-right: none;
        color: #888;
    }

    .form-control {
        border-left: none;
    }

    /* Fix border khi input group focus */
    .input-group:focus-within .input-group-text {
        border-color: var(--primary-orange);
    }

    .link-orange {
        color: var(--primary-orange);
        text-decoration: none;
        font-size: 0.9rem;
    }

        .link-orange:hover {
            text-decoration: underline;
            color: var(--dark-orange);
        }
</style>

<div class="container login-container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card login-card">
                <div class="login-header">
                    <h3>ĐĂNG NHẬP</h3>
                    <p>Chào mừng bạn quay trở lại với TechGear</p>
                </div>

                <div class="card-body p-4">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold text-secondary">Email / Tài khoản</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold text-secondary">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu..." />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label text-secondary small" asp-for="Input.RememberMe">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="link-orange">Quên mật khẩu?</a>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-orange w-100 py-2 mb-3 shadow-sm">
                            ĐĂNG NHẬP <i class="fa fa-sign-in-alt ms-1"></i>
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Bạn chưa có tài khoản?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-orange fw-bold ms-1">Đăng ký ngay</a>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="position-relative my-4">
                            <hr class="text-muted">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">Hoặc</span>
                        </div>

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="text-center">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary btn-sm m-1" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="fab fa-@provider.Name.ToLower()"></i> @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}