@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page d-flex align-items-center justify-content-center">
    <div class="auth-card card p-4 shadow-sm">
        <div class="text-center mb-3">
            <i class="bi bi-lock-fill display-4 text-primary"></i>
            <h4 class="mt-2">Đăng nhập</h4>
            <p class="text-muted small">Đăng nhập để truy cập quản trị</p>
        </div>

        @await Html.PartialAsync("~/Views/Shared/_Alert.cshtml", ViewData["Alert"] as TechGear.Models.AlertModel)

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label class="form-check-label">Ghi nhớ</label>
                </div>
                <a asp-page="/Account/ForgotPassword">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</button>
        </form>

        <div class="text-center mt-3 small">
            Bạn chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // auto-hide alert after 5s
        setTimeout(function(){
            var a = document.querySelector('.custom-alert');
            if(a) a.style.display = 'none';
        }, 5000);
    </script>
}
